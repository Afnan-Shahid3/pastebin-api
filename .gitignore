cat > .gitignore << 'EOF'
# Virtual environment
venv/
env/
.venv/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# Django
db.sqlite3
db.sqlite3-journal
*.log
media/
staticfiles/

# Environment variables
.env
.env.local

# Editor/OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db


*/migrations/*.py
*/migrations/__init__.py
EOF